{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "YandexTracker/YandexTracker.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "YandexTracker",
      "_appTitle": "YandexTracker for .NET",
      "_appLogoPath": "images/logo.svg",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/jrfrigat/YandexTracker",
        "branch": "main"
      },
      "_appFooter": "Unofficial Yandex Tracker SDK for .NET · Неофициальный SDK Яндекс Трекера"
    }
  }
}