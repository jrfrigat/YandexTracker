# Copy this file to .env and fill in your Yandex Tracker credentials.
# The integration tests (tests/YandexTracker.Tests/Integration) read them; without them those tests are skipped.
# The tests only read data - they never create or change anything in the organization.
#
# .env is in .gitignore - NEVER commit a real token.
#
# Скопируйте файл в .env и заполните доступы к Яндекс Трекеру. Без них интеграционные тесты пропускаются.
# Тесты только читают данные. Файл .env в .gitignore — не коммитьте настоящий токен.

YANDEX_TRACKER_TOKEN=
YANDEX_TRACKER_ORG_ID=
# cloud for a Yandex Cloud organization; leave empty for Yandex 360
YANDEX_TRACKER_ORG_KIND=
# optional: the queue the search test reads from (the first queue otherwise)
YANDEX_TRACKER_QUEUE=
